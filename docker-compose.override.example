services:
  cloud:
    volumes:
      - media-server_share:/mnt/shared_books:ro
  # cron runs the periodic `occ files:scan`, so it needs the same mount.
  cron:
    volumes:
      - media-server_share:/mnt/shared_books:ro

volumes:
  media-server_share:
    external: true
    name: media-server_share
